# Whitelist approach: ignore everything in root, then explicitly include.
# Matches the same defensive pattern used in the primer project so that
# scratch files, secrets, and editor noise can never accidentally be committed.

/*
!/.gitignore
!/.env.example
!/README.md
!/index.html
!/the-workshop.html
!/about.html
!/archive.html
!/404.html
!/styles.css
!/site.js
!/favicon.svg
!/favicon.png
!/robots.txt
!/sitemap.xml
!/machines/
!/CNAME
!/CLAUDE.md
!/SESSION_LOG.md
!/SETUP_NOTES.md
!/Images/
!/tools/
!/.github/

# Inside whitelisted directories, ignore typical OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp

# NEVER publish raw phone photos — they carry GPS EXIF (location privacy).
# The site only serves the EXIF-stripped derivatives in Images/web/.
Images/Front Page/
Images/*/_incoming/
Images/*/_originals/
Images/*/_classifications.txt
Images/*/_review.html

# Stray file from another project
Images/Requirements*

# Secrets — NEVER commit
.env

# Python build / cache artifacts
tools/__pycache__/
tools/.venv/
tools/*.pyc

# Node artifacts (in case PDF-build infrastructure is added later)
node_modules/
